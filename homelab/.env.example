# Copy to .env and fill in for this host. Never commit .env itself.
# This is what makes the stack portable -- moving host means copying the
# repo and writing a fresh .env, nothing else changes.

# Tailscale IP or MagicDNS hostname of this machine, reachable from wherever
# you open Homepage/Portainer.
TAILSCALE_HOST=100.127.203.80

HOMEPAGE_PORT=3000
PORTAINER_PORT=9000
